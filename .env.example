# ==============================================================================
# Obsidian Telemetry — Environment Configuration
# Copy this file to .env and configure values for your environment.
# Never commit .env, real kubeconfigs, or bearer tokens to version control.
# ==============================================================================

# Server & CLI Network Defaults
NODE_ENV=development
OT_HOST=0.0.0.0
OT_PORT=1392
CORS_ORIGIN=

# Optional custom directory for persistent config, credentials, audit log, and state:
# OT_HOME=/var/lib/obsidian-telemetry

# Authentication & RBAC
# AUTH_MODE defaults to "token" in production / `ot` CLI mode, or "optional" in development.
#   "token"    -> Requires local credentials or valid role token for all API & WS routes
#   "optional" -> Unauthenticated requests get read-only "viewer" access; mutating
#                 operations still require authentication
AUTH_MODE=optional
# Set OT_ADMIN_PASSWORD to define the initial admin password during headless bootstrap:
# OT_ADMIN_PASSWORD=
SESSION_SECRET=replace-with-a-long-random-hex-secret-at-least-32-chars
OBSIDIAN_ADMIN_TOKEN=replace-with-admin-bearer-token
OBSIDIAN_OPERATOR_TOKEN=replace-with-operator-bearer-token
OBSIDIAN_VIEWER_TOKEN=replace-with-viewer-bearer-token

# Kubernetes Connection
# KUBE_MODE: "auto" | "kubeconfig" | "incluster" | "token" | "disabled"
KUBE_MODE=auto
KUBECONFIG_PATH=
KUBE_CONTEXT=
K8S_API_SERVER=
K8S_BEARER_TOKEN=
K8S_SKIP_TLS_VERIFY=false

# Prometheus Integration
PROMETHEUS_URL=
PROMETHEUS_BEARER_TOKEN=
PROMETHEUS_TIMEOUT_MS=5000

# Safety & Execution Controls
# Pod exec WebSocket is disabled by default; requires ENABLE_POD_EXEC=true and admin role
ENABLE_POD_EXEC=false
EXEC_TIMEOUT_MS=300000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240

# Explicit Demo Mode
# When true, users may explicitly switch to clearly labeled synthetic demo clusters
# while disconnected from live Kubernetes/Prometheus infrastructure.
ENABLE_DEMO_MODE=true
