{
  "name": "obsidian-telemetry",
  "private": false,
  "version": "1.0.0",
  "description": "Open-source cloud-native infrastructure observability, Kubernetes cluster telemetry, and live incident response console.",
  "license": "MIT",
  "author": "Obsidian Telemetry Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/devlopergit04/Obsidian-Telemetry.git"
  },
  "homepage": "https://github.com/devlopergit04/Obsidian-Telemetry#readme",
  "bugs": {
    "url": "https://github.com/devlopergit04/Obsidian-Telemetry/issues"
  },
  "keywords": [
    "observability",
    "kubernetes",
    "telemetry",
    "devops",
    "sre",
    "dashboard",
    "react",
    "typescript",
    "tailwindcss"
  ],
  "type": "module",
  "main": "./dist-server/src/server/app.js",
  "types": "./dist-server/src/server/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist-server/src/server/app.d.ts",
      "default": "./dist-server/src/server/app.js"
    }
  },
  "bin": {
    "ot": "./dist-server/src/cli/ot.js"
  },
  "files": [
    "dist",
    "dist-server",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:client": "vite --port=5173 --host=0.0.0.0",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json && node -e \"require('node:fs').chmodSync('dist-server/src/cli/ot.js', 0o755)\"",
    "build": "npm run build:client && npm run build:server",
    "prepack": "npm run build",
    "start": "node server.ts",
    "ot": "node dist-server/src/cli/ot.js",
    "preview": "vite preview --port=1392 --host=0.0.0.0",
    "clean": "rm -rf dist dist-server server.js",
    "lint": "tsc --noEmit",
    "lint:code": "oxlint --deny-warnings src server.ts tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "jsdom": "^31.0.1",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
